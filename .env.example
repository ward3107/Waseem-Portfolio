# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# ==========================================
# API Keys
# ==========================================

# Gemini API Key (if using AI features)
# Get your key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Application Settings
# ==========================================

# Site URL (for production)
VITE_SITE_URL=http://localhost:5173

# ==========================================
# Analytics (Optional)
# ==========================================

# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# ==========================================
# Contact Form
# ==========================================

# Web3Forms access key (required for contact form to work)
# Get your key from: https://web3forms.com
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# Newsletter endpoint (e.g. Formspree or Buttondown).
# Leave empty to disable the footer newsletter form.
# VITE_NEWSLETTER_ENDPOINT=https://formspree.io/f/your-form-id

# Optional: FormSubmit endpoint fallback
# VITE_FORM_ENDPOINT=https://formsubmit.co/your-email@example.com

# ==========================================
# Contact Info
# ==========================================

# WhatsApp number (no + or spaces, e.g. 972534260632)
VITE_WHATSAPP_NUMBER=972534260632

# Public email shown in contact section
VITE_CONTACT_EMAIL=hello@example.com

# ==========================================
# Social Media Links (Optional)
# ==========================================

# These can also be updated in constants.ts
# VITE_GITHUB_URL=https://github.com/ward3107
# VITE_LINKEDIN_URL=https://linkedin.com/in/yourusername
# VITE_TWITTER_URL=https://twitter.com/yourusername

# ==========================================
# Supabase (admin panel + content)
# ==========================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

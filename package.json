    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.2.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wawoff2": "^2.0.1"
  },

    "postbuild": "node scripts/generate-video-ads.mjs && node scripts/generate-onetap-share.mjs && node scripts/generate-home-locales.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "nap-audit": "node scripts/nap-audit.mjs"
  },
  "dependencies": {
